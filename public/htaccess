# Без этого файла: прямая ссылка на товар (/catalog/podkategoriya/tovar)
# или обновление страницы (F5) внутри каталога будут давать 404 — потому
# что физически такого файла на сервере нет, весь роутинг рисует React
# Router в браузере. Правило ниже говорит Apache: если запрошенного файла
# или папки нет на диске — всё равно отдавай index.html, а дальше уже
# React Router сам разберётся, что показывать по адресу в браузере.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Настоящие файлы (js, css, картинки, index.html и т.п.) отдаём как есть.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Всё остальное — на index.html, роутинг решает React Router.
  RewriteRule ^ index.html [L]
</IfModule>

# Небольшой бонус, раз уж правим Apache: гасим кэш для index.html (чтобы
# после каждого деплоя браузер сразу видел новую версию сайта, а не старую
# закэшированную), и наоборот подольше кэшируем статику с хэшами в имени
# (assets/index-XXXXXXXX.js) — она и так меняет имя при каждой сборке.
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|jpg|jpeg|png|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
